# Production Environment Template
# Copy this file to .env and fill in the values

# Use Tailscale IP (100.x.x.x) or ZeroTier IP (10.x.x.x) for the Android Gateway
ANDROID_SMS_API_URL=http://100.x.x.x:8082
ANDROID_SMS_API_KEY=

SMS_API_KEY=your-strong-api-key
SECRET_KEY=your-strong-secret-key

DATABASE_URL=sqlite:///./sms_auto.db

MAX_SMS_RETRIES=3
SMS_RATE_LIMIT_PER_MINUTE=30
SMS_RATE_LIMIT_PER_PHONE=3

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://api.yourdomain.com,http://localhost:5173
