# Local Development Environment Template
# Copy this file to .env and fill in the values

ANDROID_SMS_API_URL=http://100.120.152.19:8082/
ANDROID_SMS_API_KEY=

SMS_API_KEY=change-me
SECRET_KEY=change-me

DATABASE_URL=sqlite:///./sms_auto.db

MAX_SMS_RETRIES=3
SMS_RATE_LIMIT_PER_MINUTE=30
SMS_RATE_LIMIT_PER_PHONE=3

ALLOWED_ORIGINS=http://localhost:5173

# Email SMTP Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_gmail@gmail.com
EMAIL_SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME=SMS Gateway
EMAIL_FROM_ADDRESS=your_gmail@gmail.com
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
